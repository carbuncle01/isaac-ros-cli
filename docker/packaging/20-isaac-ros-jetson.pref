# Prefer CUDA packages from the Jetson repository over the global CUDA 13.2
# preference and packages available from another repository.
Package: cuda-* libnv*
Pin: origin repo.download.nvidia.com
Pin-Priority: 1002

# Prefer all other Jetson packages over packages from other configured NVIDIA
# repositories, including the CUDA SBSA repository pinned at priority 600.
Package: *
Pin: origin repo.download.nvidia.com
Pin-Priority: 700
