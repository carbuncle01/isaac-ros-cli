# Keep the JetPack 7.2 TensorRT package family on one version.  The generic
# SBSA CUDA repository may also publish newer TensorRT major versions, while
# the Jetson r39.2 repository provides the Orin-enabled 10.16 build.
Package: libnvinfer* tensorrt* libnvonnxparsers* python3-libnvinfer*
Pin: version 10.16.2.10-1+cuda13.2
Pin-Priority: 1001

# Prefer the JetPack 7.2 packages over newer generic SBSA packages.  Keeping
# libcudart aligned with the r39.2 host driver is important on Jetson Orin.
Package: *
Pin: release n=r39.2
Pin-Priority: 1001

# Keep Jetson BSP user-space libraries ABI-compatible with the JetPack 7.2
# host. The r39.2 repository also carries newer point releases.
Package: nvidia-l4t-*
Pin: version 39.2.0-20260601141651
Pin-Priority: 1001

# Match the VPI user-space runtime installed on the JetPack 7.2 host.
Package: libnvvpi4 vpi4-*
Pin: version 4.1.3
Pin-Priority: 1001
