# syntax=docker/dockerfile:1
# Additional Isaac ROS development settings.
ARG BASE_IMAGE=ubuntu:24.04
ARG PLATFORM=amd64
ARG UV_VERSION=0.12.0
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${BASE_IMAGE} AS common

USER root
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# CycloneDDS runtime defaults. The profile is copied near the end so edits to
# the XML do not invalidate the heavy APT and Python layers above it.
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml
ENV ROS_DOMAIN_ID=50

# The current Isaac ROS entrypoint creates/updates this user at container start
# so it can match the host UID/GID. Avoid creating it at build time.
ARG USERNAME=admin
ENV USERNAME=${USERNAME}

WORKDIR /workspaces

# Only the standalone executable is copied, not another Python distribution.
# Avoid storing a second copy when silky_evcam already supplied this version.
RUN --mount=type=bind,from=uv,source=/uv,target=/tmp/uv,readonly \
    if ! command -v uv >/dev/null || [ "$(uv --version)" != "$(/tmp/uv --version)" ]; then \
        install -m 755 /tmp/uv /usr/local/bin/uv; \
    fi
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
ARG PLATFORM
RUN test "${PLATFORM}" = "$(dpkg --print-architecture)" \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' \
        > /etc/apt/apt.conf.d/keep-cache

# Base utilities needed by this layer.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        gosu \
        lsb-release \
        python3-pip \
        python3-setuptools \
        python3-venv \
        sudo \
        udev \
        rsync \
    && rm -rf /var/lib/apt/lists/*

# Isaac ROS feature roots used by JetPilot.
#
# Keep this list at the feature level. APT pulls the required Isaac ROS Common,
# GXF, NITROS, type-adaptation, and interface packages transitively. Explicitly
# listing every package in those dependency trees makes optional pipelines such
# as RT-DETR, SegFormer, Triton, and UNet part of the image even though JetPilot
# does not launch them.
#
# Feature mapping:
# - isaac_mapping_ros / visual_mapping: offline tools in runtime-amd64 below
# - launch_utils: JetPilot launch files
# - dnn_image_encoder / tensor_rt: GPU image preprocessing and JetPilot E2E inference
# - NITROS image / tensor_list types: explicit E2E graph contracts
# - visual_global_localization / visual_slam: localization
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-isaac-ros-dnn-image-encoder \
        ros-jazzy-isaac-ros-launch-utils \
        ros-jazzy-isaac-ros-nitros-image-type \
        ros-jazzy-isaac-ros-nitros-tensor-list-type \
        ros-jazzy-isaac-ros-tensor-list-interfaces \
        ros-jazzy-isaac-ros-tensor-rt \
        ros-jazzy-isaac-ros-visual-global-localization \
        ros-jazzy-isaac-ros-visual-slam \
    && rm -rf /var/lib/apt/lists/*

# ROS Python extensions such as the OpenCV binding shipped by Ubuntu/Isaac ROS
# are built against the NumPy 1.x ABI.  Some upstream image layers install
# unconstrained Python packages into /usr/local and can consequently upgrade
# the system interpreter to NumPy 2.x.  Keep that interpreter on the ABI used
# by ROS; the independent /opt/env ML environment intentionally keeps NumPy 2.
ARG ROS_SYSTEM_NUMPY_VERSION=1.26.4
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --python /usr/bin/python3 --break-system-packages --reinstall --no-deps \
        "numpy==${ROS_SYSTEM_NUMPY_VERSION}" \
    && python3 -c "import cv2, numpy; assert numpy.__version__ == '${ROS_SYSTEM_NUMPY_VERSION}', numpy.__version__; print(f'ROS Python OpenCV OK; NumPy {numpy.__version__}; OpenCV {cv2.__version__}')"

# ROS packages.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-rmw-cyclonedds-cpp \
        ros-jazzy-ackermann-msgs \
        ros-jazzy-asio-cmake-module \
        ros-jazzy-laser-filters \
        ros-jazzy-laser-proc \
        ros-jazzy-camera-info-manager \
        ros-jazzy-cartographer \
        ros-jazzy-cartographer-ros \
        ros-jazzy-foxglove-bridge \
        ros-jazzy-image-transport-plugins \
        ros-jazzy-joy \
        ros-jazzy-rosbag2-tools \
        ros-jazzy-serial-driver \
        ros-jazzy-tf2-tools \
        ros-jazzy-usb-cam \
        ros-jazzy-vision-msgs \
    && rm -rf /var/lib/apt/lists/*

# Basic utilities.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        bluez \
        can-utils \
        dialog \
        fzf \
        htop \
        iproute2 \
        joystick \
        net-tools \
        sshpass \
        tmux \
        tree \
        vim \
        wget \
    && rm -rf /var/lib/apt/lists/*

FROM common AS urg-builder

# Hokuyo urg_node2.
# Keep the source revision pinned so container builds remain reproducible.
# urg_library is a git submodule, so both clone and checkout must update
# submodules recursively.
ARG ROS_DISTRO=jazzy
ARG URG_NODE2_GIT_URL=https://github.com/Hokuyo-aut/urg_node2.git
ARG URG_NODE2_VERSION=f02d8af22db2a4322217f4c5803494f4ca2903ff

RUN set -eux; \
    git clone --recursive "${URG_NODE2_GIT_URL}" /tmp/urg_node2; \
    cd /tmp/urg_node2; \
    git checkout "${URG_NODE2_VERSION}"; \
    git submodule update --init --recursive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        devscripts \
        dh-make \
        fakeroot \
        python3-bloom \
    && source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && rosdep update \
    && rosdep install -y \
        --from-paths /tmp/urg_node2 \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    set -ex; \
    source "/opt/ros/${ROS_DISTRO}/setup.bash"; \
    cd /tmp/urg_node2; \
    bloom-generate rosdebian --ros-distro "${ROS_DISTRO}"; \
    fakeroot debian/rules binary; \
    mkdir -p /out; \
    cp /tmp/ros-${ROS_DISTRO}-urg-node2_*.deb /out/

FROM common AS runtime
COPY --from=urg-builder /out/*.deb /tmp/urg-debs/
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends /tmp/urg-debs/*.deb \
    && rm -rf /tmp/urg-debs /var/lib/apt/lists/*

# RTP video experiment tools. Keep this near the end so changes here do not
# invalidate heavier ROS and sensor build layers above.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        chrony \
        gstreamer1.0-libav \
        gstreamer1.0-nice \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-tools \
        gir1.2-gst-plugins-bad-1.0 \
        gir1.2-gst-plugins-base-1.0 \
        gir1.2-gstreamer-1.0 \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        python3-gi \
        python3-gst-1.0 \
        tcpdump \
        v4l-utils \
    && rm -rf /var/lib/apt/lists/*

# Separate builder: calibration and GUI changes do not reinstall training wheels.
FROM runtime AS training-amd64
COPY requirements-training-gpu-amd64.txt /tmp/requirements-training-gpu-amd64.txt
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv venv --python /usr/bin/python3 /opt/env \
    && uv pip install --require-hashes --python /opt/env/bin/python \
        -r /tmp/requirements-training-gpu-amd64.txt
COPY requirements-training-amd64.txt /tmp/requirements-training-amd64.txt
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --require-hashes --python /opt/env/bin/python \
        -c /tmp/requirements-training-gpu-amd64.txt \
        -r /tmp/requirements-training-amd64.txt
# Override with an immutable commit for fully reproducible training builds.
ARG TRAJECTORY_HELPERS_REF=master
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --python /opt/env/bin/python --no-deps \
        "git+https://github.com/carbuncle01/trajectory_planning_helpers.git@${TRAJECTORY_HELPERS_REF}"

# BuildKit only builds the selected architecture branch.
FROM runtime AS runtime-arm64
# isaac_ros_jetson_stats is published for Jetson arm64 only. The x86 image
# deliberately omits it and disables the corresponding launch feature by default.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    set -eux; \
    if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends ros-jazzy-isaac-ros-jetson-stats; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Jetson status monitor (jtop). The client in this image communicates with the
# host service through /run/jtop.sock, so both sides must use the same version.
# Pin the immutable commit behind tag 7.2.0 rather than a moving branch.
#
# jetson-stats 7.2.0 also lets an optional library-probing failure escape from
# its background thread. Apply a narrow compatibility patch so a missing VPI
# transitive dependency does not prevent Isaac ROS diagnostics from starting.
ARG JETSON_STATS_VERSION=7.2.0
ARG JETSON_STATS_REF=3c1ba9ac49a1307c9d7c53646bb70ba8c16b8759
COPY patches/jetson-stats-7.2.0-library-probe.patch \
    /tmp/jetson-stats-library-probe.patch
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    set -eux; \
    if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        git init /tmp/jetson_stats; \
        git -C /tmp/jetson_stats remote add origin \
            https://github.com/rbonghi/jetson_stats.git; \
        git -C /tmp/jetson_stats fetch --depth 1 origin "${JETSON_STATS_REF}"; \
        git -C /tmp/jetson_stats checkout --detach FETCH_HEAD; \
        test "$(git -C /tmp/jetson_stats rev-parse HEAD)" = "${JETSON_STATS_REF}"; \
        git -C /tmp/jetson_stats apply /tmp/jetson-stats-library-probe.patch; \
        uv pip install --no-cache --python /usr/bin/python3 --break-system-packages /tmp/jetson_stats; \
        test "$(python3 -c 'import jtop; print(jtop.__version__)')" = \
            "${JETSON_STATS_VERSION}"; \
        rm -rf /tmp/jetson_stats; \
    fi; \
    rm -f /tmp/jetson-stats-library-probe.patch

FROM runtime AS runtime-amd64
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-isaac-ros-visual-mapping \
        ros-jazzy-isaac-mapping-ros \
    && rm -rf /var/lib/apt/lists/*

# Offline RGB/EVS calibration and LED synchronization environment. Keep this
# near the end so dependency changes do not invalidate the heavy ROS layers.
# System site packages expose ROS, OpenCV, event_camera_py and Metavision;
# NumPy remains pinned to the ABI used by their binary extensions.
COPY requirements-multi-sensor-calibration.txt \
    /tmp/requirements-multi-sensor-calibration.txt
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    set -eux; \
    uv venv --python /usr/bin/python3 --system-site-packages \
        /opt/multi_sensor_calibration_env; \
    uv pip install --require-hashes --python /opt/multi_sensor_calibration_env/bin/python \
        -r /tmp/requirements-multi-sensor-calibration.txt; \
    /opt/multi_sensor_calibration_env/bin/python -c \
        "import cv2, numpy, rosbags, yaml; assert numpy.__version__ == '1.26.4', numpy.__version__; print(f'multi_sensor_calibration env OK; NumPy {numpy.__version__}; OpenCV {cv2.__version__}')"; \
    rm -f /tmp/requirements-multi-sensor-calibration.txt
ENV MULTI_SENSOR_CALIBRATION_VENV=/opt/multi_sensor_calibration_env

# The same absolute path and base interpreter make the venv relocatable here.
COPY --from=training-amd64 /opt/env /opt/env

FROM runtime-${PLATFORM} AS final
# Desktop tooling is a capability, independent of the CPU architecture.
# auto: amd64 only; true: also useful for Jetson with a local display.
ARG INSTALL_GUI=auto
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    set -eu; \
    case "${INSTALL_GUI}" in auto|true|false) ;; *) exit 1 ;; esac; \
    if [ "${INSTALL_GUI}" = true ] || { [ "${INSTALL_GUI}" = auto ] && [ "$(dpkg --print-architecture)" = amd64 ]; }; then \
        apt-get update; \
        apt-get install -y --no-install-recommends ros-jazzy-cartographer-rviz ros-jazzy-rqt-tf-tree terminator; \
    fi; \
    rm -rf /var/lib/apt/lists/*
# Copy lightweight runtime configuration last so edits to these files only
# invalidate the final Docker layers.
COPY middleware_profiles/cyclonedds.xml /etc/cyclonedds.xml
RUN mkdir -p /usr/local/bin/scripts/entrypoint_additions
COPY scripts/entrypoint_additions/*.sh /usr/local/bin/scripts/entrypoint_additions/
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/*.sh || true
