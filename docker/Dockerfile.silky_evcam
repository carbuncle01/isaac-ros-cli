# syntax=docker/dockerfile:1
# Dockerfile for building OpenEB with the CenturyArks SilkyEvCam plugin.
#
# Before building, manually obtain and extract the official plugin source from
# CenturyArks, then place hal/, hal_psee_plugins/, and licensing/ under:
#   docker/silky_evcam_plugin_source/
ARG BASE_IMAGE=ubuntu:24.04
ARG PLATFORM=amd64
ARG UV_VERSION=0.12.0
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${BASE_IMAGE} AS openeb

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/bin:${PATH}

ARG OPENEB_GIT_URL=https://github.com/prophesee-ai/openeb.git
ARG OPENEB_VERSION=5.2.0
ARG OPENEB_BUILD_JOBS=2

WORKDIR /opt
USER root
ARG PLATFORM
RUN test "${PLATFORM}" = "$(dpkg --print-architecture)" \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' \
        > /etc/apt/apt.conf.d/keep-cache
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libboost-filesystem-dev \
        libboost-program-options-dev \
        libboost-thread-dev \
        libboost-timer-dev \
        libeigen3-dev \
        libglew-dev \
        libglfw3-dev \
        libhdf5-dev \
        libopencv-dev \
        libprotobuf-dev \
        libssl-dev \
        libusb-1.0-0-dev \
        pkg-config \
        pybind11-dev \
        python3-dev \
        python3-h5py \
        python3-numpy \
        python3-pybind11 \
        python3-pip \
        python3-venv \
        ros-jazzy-event-camera-codecs \
        ros-jazzy-event-camera-msgs \
        ros-jazzy-event-camera-py \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY silky_evcam_plugin_source/ /tmp/silky_evcam_plugin_source/

RUN set -eux; \
    git clone --depth 1 --branch "${OPENEB_VERSION}" "${OPENEB_GIT_URL}" /opt/openeb; \
    test -d /tmp/silky_evcam_plugin_source/hal; \
    test -d /tmp/silky_evcam_plugin_source/hal_psee_plugins; \
    test -d /tmp/silky_evcam_plugin_source/licensing; \
    cp -av \
        /tmp/silky_evcam_plugin_source/hal \
        /tmp/silky_evcam_plugin_source/hal_psee_plugins \
        /tmp/silky_evcam_plugin_source/licensing \
        /opt/openeb/; \
    cmake -S /opt/openeb -B /opt/openeb/build \
        -DBUILD_TESTING=OFF \
        -DCOMPILE_PYTHON3_BINDINGS=ON \
        -DCMAKE_BUILD_TYPE=Release; \
    cmake --build /opt/openeb/build --config Release -- -j"${OPENEB_BUILD_JOBS}"; \
    cmake --install /opt/openeb/build; \
    ldconfig; \
    mkdir -p /tmp/e2v-models; \
    if [ "${PLATFORM}" = amd64 ]; then \
        cp /opt/openeb/sdk/modules/core_ml/models/e2v.ckpt /tmp/e2v-models/; \
    fi; \
    rm -rf /opt/openeb /tmp/silky_evcam_plugin_source; \
    if [ "${PLATFORM}" = amd64 ]; then \
        mkdir -p /opt/openeb/sdk/modules/core_ml/models; \
        mv /tmp/e2v-models/e2v.ckpt /opt/openeb/sdk/modules/core_ml/models/; \
    fi; \
    rmdir /tmp/e2v-models

# Runtime branches keep the recording-only Jetson image free of E2V wheels.
FROM openeb AS runtime-arm64

FROM openeb AS runtime-amd64
ARG E2V_TORCH_VERSION=2.9.0+cu130
ARG E2V_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# Keep PyTorch after OpenEB: wheel updates must not recompile the camera SDK.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --python /usr/bin/python3 --break-system-packages \
        --index-url "${E2V_TORCH_INDEX_URL}" "torch==${E2V_TORCH_VERSION}"

# NumPy 1.x ABI for ROS event_camera_py; use the existing system interpreter.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv venv --python /usr/bin/python3 --system-site-packages /opt/event_camera_env \
    && uv pip install --python /opt/event_camera_env/bin/python "numpy==1.26.4"
ENV METAVISION_E2V_CHECKPOINT=/opt/openeb/sdk/modules/core_ml/models/e2v.ckpt
RUN set -ex; \
    test -s "${METAVISION_E2V_CHECKPOINT}"; \
    source /opt/ros/jazzy/setup.bash; \
    /opt/event_camera_env/bin/python -c "import event_camera_py, numpy, torch; assert numpy.__version__ == '1.26.4', numpy.__version__; assert torch.version.cuda and torch.version.cuda.split('.')[0] == '13', torch.version.cuda; from metavision_core.event_io import EventsIterator; from metavision_core_ml.event_to_video.event_to_video import EventToVideo; print(f'event_camera_py OK; NumPy {numpy.__version__}; E2V PyTorch {torch.__version__}, CUDA build {torch.version.cuda}')"

FROM runtime-${PLATFORM} AS final
