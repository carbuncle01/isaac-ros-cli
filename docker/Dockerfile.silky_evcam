# Dockerfile for building OpenEB with the CenturyArks SilkyEvCam plugin.
#
# Before building, manually obtain and extract the official plugin source from
# CenturyArks, then place hal/, hal_psee_plugins/, and licensing/ under:
#   docker/silky_evcam_plugin_source/
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH:-}
ENV CMAKE_PREFIX_PATH=/usr/local:${CMAKE_PREFIX_PATH:-}

ARG OPENEB_GIT_URL=https://github.com/prophesee-ai/openeb.git
ARG OPENEB_VERSION=5.2.0
ARG OPENEB_BUILD_JOBS=2
ARG E2V_TORCH_VERSION=2.9.0+cu130
ARG E2V_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG TARGETARCH
ARG PLATFORM

WORKDIR /opt

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libboost-filesystem-dev \
        libboost-program-options-dev \
        libboost-thread-dev \
        libboost-timer-dev \
        libeigen3-dev \
        libglew-dev \
        libglfw3-dev \
        libhdf5-dev \
        libopencv-dev \
        libprotobuf-dev \
        libssl-dev \
        libusb-1.0-0-dev \
        pkg-config \
        pybind11-dev \
        python3-dev \
        python3-h5py \
        python3-numpy \
        python3-pybind11 \
        python3-pip \
        ros-jazzy-event-camera-codecs \
        ros-jazzy-event-camera-msgs \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# E2V reconstruction runs only on x86_64. Install PyTorch into the system
# interpreter used by ros2 run. Do not install it on Jetson/arm64, where this
# image is used only for OpenEB/SilkyEvCam event recording.
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    target_arch="${TARGETARCH:-${PLATFORM:-$(dpkg --print-architecture)}}"; \
    case "${target_arch}" in \
        amd64|x86_64) \
            python3 -m pip install --break-system-packages \
                --index-url "${E2V_TORCH_INDEX_URL}" \
                "torch==${E2V_TORCH_VERSION}"; \
            ;; \
        arm64|aarch64) \
            echo "Skipping PyTorch installation on ${target_arch}"; \
            ;; \
        *) \
            echo "Unsupported Docker target architecture: ${target_arch}" >&2; \
            exit 1; \
            ;; \
    esac

RUN git clone --depth 1 --branch "${OPENEB_VERSION}" "${OPENEB_GIT_URL}" /opt/openeb

COPY silky_evcam_plugin_source/ /tmp/silky_evcam_plugin_source/

RUN set -eux; \
    test -d /tmp/silky_evcam_plugin_source/hal; \
    test -d /tmp/silky_evcam_plugin_source/hal_psee_plugins; \
    test -d /tmp/silky_evcam_plugin_source/licensing; \
    cp -av \
        /tmp/silky_evcam_plugin_source/hal \
        /tmp/silky_evcam_plugin_source/hal_psee_plugins \
        /tmp/silky_evcam_plugin_source/licensing \
        /opt/openeb/; \
    rm -rf /tmp/silky_evcam_plugin_source

RUN set -eux; \
    cmake -S /opt/openeb -B /opt/openeb/build \
        -DBUILD_TESTING=OFF \
        -DCOMPILE_PYTHON3_BINDINGS=ON \
        -DCMAKE_BUILD_TYPE=Release; \
    cmake --build /opt/openeb/build --config Release -- -j"${OPENEB_BUILD_JOBS}"; \
    cmake --install /opt/openeb/build; \
    ldconfig

# multi_sensor_calibration resolves this path by default. Event recording runs
# on both architectures, while PyTorch E2V reconstruction is supported only on
# x86_64/amd64.
ENV METAVISION_E2V_CHECKPOINT=/opt/openeb/sdk/modules/core_ml/models/e2v.ckpt

RUN set -eux; \
    target_arch="${TARGETARCH:-${PLATFORM:-$(dpkg --print-architecture)}}"; \
    case "${target_arch}" in \
        amd64|x86_64) \
            test -s "${METAVISION_E2V_CHECKPOINT}"; \
            python3 -c "import torch; assert torch.version.cuda and torch.version.cuda.split('.')[0] == '13', torch.version.cuda; from metavision_core.event_io import EventsIterator; from metavision_core_ml.event_to_video.event_to_video import EventToVideo; print(f'E2V PyTorch {torch.__version__}, CUDA build {torch.version.cuda}')"; \
            ;; \
        arm64|aarch64) \
            echo "Skipping Python E2V validation on ${target_arch}; OpenEB/SilkyEvCam event recording remains enabled"; \
            ;; \
        *) \
            echo "Unsupported Docker target architecture: ${target_arch}" >&2; \
            exit 1; \
            ;; \
    esac
