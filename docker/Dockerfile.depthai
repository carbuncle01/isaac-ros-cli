# Docker layer for the Luxonis DepthAI ROS 3 driver used by OAK cameras.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

USER root
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

ARG ROS_DISTRO=jazzy
ARG DEPTHAI_ROS_VERSION=v3.2.1-jazzy
ARG DEPTHAI_CORE_VERSION=ros-v3.6.1-jazzy.2
ARG DEPTHAI_BUILD_JOBS=2
ARG DEPTHAI_ROS_WS=/opt/depthai_ros_ws

# Build the versioned Jazzy packages from pinned upstream tags.  The v3
# packages intentionally use the _v3 suffix on Jazzy.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        libusb-1.0-0-dev \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p "${DEPTHAI_ROS_WS}/src"; \
    git clone --depth 1 --branch "${DEPTHAI_ROS_VERSION}" \
        https://github.com/luxonis/depthai-ros.git \
        "${DEPTHAI_ROS_WS}/src/depthai-ros"; \
    git clone --depth 1 --branch "${DEPTHAI_CORE_VERSION}" \
        https://github.com/luxonis/depthai-core.git \
        "${DEPTHAI_ROS_WS}/src/depthai-core"; \
    git -C "${DEPTHAI_ROS_WS}/src/depthai-core" \
        submodule update --init --recursive --depth 1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && rosdep update \
    && rosdep install -y \
        --from-paths "${DEPTHAI_ROS_WS}/src" \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    set +u; \
    source "/opt/ros/${ROS_DISTRO}/setup.bash"; \
    set -u; \
    cd "${DEPTHAI_ROS_WS}"; \
    MAKEFLAGS="-j${DEPTHAI_BUILD_JOBS} -l${DEPTHAI_BUILD_JOBS}" \
        colcon build \
        --merge-install \
        --executor sequential \
        --packages-up-to depthai_ros_driver_v3 \
        --cmake-args \
            -DCMAKE_BUILD_TYPE=Release \
            -DBUILD_TESTING=OFF \
            -DTEST_DEPTHAI_ROS_DRIVER=OFF; \
    printf '%s\n' \
        "source ${DEPTHAI_ROS_WS}/install/setup.bash" \
        >> /etc/bash.bashrc; \
    rm -rf "${DEPTHAI_ROS_WS}/build" "${DEPTHAI_ROS_WS}/log" \
        "${DEPTHAI_ROS_WS}/src"
